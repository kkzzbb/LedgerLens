# LedgerLens environment variables. Copy this file to .env and adjust it.
# .env is ignored by git. Never put a real secret in this file.
# The backend and DemoBank read these from the process environment only
# (Docker Compose passes .env to the containers). An empty value means
# "not set".

# Required. Postgres connection string (it holds the database password)
DATABASE_URL=postgresql://ledgerlens:ledgerlens@db:5432/ledgerlens
# Tests only. A PostgreSQL server where each test run creates and drops its
# own database (e.g. postgresql://ledgerlens:ledgerlens@localhost:5432/postgres).
# Empty means the DB tests are skipped
TEST_DATABASE_URL=
# Required. DemoBank API key (fake demo value): the backend sends it in the
# X-API-Key header and DemoBank requires it on every /v1/* route. One value,
# shared by both services through Compose
DEMOBANK_API_KEY=demo-api-key

# Base URL of the DemoBank API
DEMOBANK_BASE_URL=http://demobank:8100
# Turns the demo features on (true, false, 1 or 0)
DEMO_MODE=true
# Seconds between two sync cycles (1 or more)
SYNC_INTERVAL_SECONDS=120
# Transactions asked from DemoBank per page (1 to 500)
SYNC_PAGE_SIZE=100
# Attempts per sync cycle before the cycle fails (1 or more)
SYNC_MAX_ATTEMPTS=3
# Base retry delay in seconds for the exponential backoff (1 or more)
SYNC_BACKOFF_BASE_SECONDS=5
# Longest retry delay in seconds (not lower than SYNC_BACKOFF_BASE_SECONDS)
SYNC_BACKOFF_CAP_SECONDS=120
# Minutes without a successful sync before the data counts as stale (1 or more)
STALE_THRESHOLD_MINUTES=30
# Failed sync jobs in a row before the watchdog raises an alert (1 or more)
FAILURE_STREAK_THRESHOLD=3
# DemoBank admin scenario routes, #12 (true, false, 1 or 0). When true,
# DEMOBANK_ADMIN_KEY must be set and differ from DEMOBANK_API_KEY
DEMOBANK_ADMIN_ENABLED=false
# Key for the DemoBank scenario controls (empty: not configured): the backend
# sends it and DemoBank requires it on the admin routes. One value, shared by
# both services through Compose
DEMOBANK_ADMIN_KEY=
# Required. DemoBank's Postgres connection string (it holds the database
# password): the Compose database, the same server and database as the
# backend. DemoBank uses only the demobank_sim schema
DEMOBANK_DATABASE_URL=postgresql://ledgerlens:ledgerlens@db:5432/ledgerlens
# Seed of DemoBank's generated history (a non-negative integer)
DEMOBANK_SEED=42
# Last day of DemoBank's generated history, YYYY-MM-DD (empty means "the date
# of first generation"). Once the history exists, the stored seed and date win
DEMOBANK_ANCHOR_DATE=
# Anthropic API key for the AI agents (empty: agents are disabled)
ANTHROPIC_API_KEY=
# Model the AI agents use
AGENT_MODEL=claude-opus-5-5
# OTLP endpoint for telemetry (empty: nothing is exported)
OTEL_EXPORTER_OTLP_ENDPOINT=
